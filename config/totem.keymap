//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

// #define Base        0
// #define Nav         1
// #define Sym         2
// #define Fun         3
// #define Game        4
// #define Gameplus    5

&mt {
    quick-tap-ms = <100>;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <200>;
};

&sk { quick-release; };

/ {
    behaviors {
        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <120>;
            tapping-term-ms = <210>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <4 14 25 33 34 32 0 1 2 3 10 11 12 13 22 23 24 21 20>;
            hold-trigger-on-release;
            label = "HOMEROW_MODS_RIGHT";
        };

        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <120>;
            tapping-term-ms = <210>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 26 27 28 29 30 31 36 37 35>;
            hold-trigger-on-release;
            label = "HOMEROW_MODS_LEFT";
        };

        magic_shift_tap: magic_shift_tap {
            compatible = "zmk,behavior-mod-morph";
            label = "MAGIC_SHIFT_TAP";
            bindings = <&sk LEFT_SHIFT>, <&caps_word>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        magic_shift: magic_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "MAGIC_SHIFT";
            bindings = <&kp>, <&magic_shift_tap>;

            #binding-cells = <2>;
            tapping-term-ms = <175>;
            flavor = "tap-preferred";
        };

        // Game mod-tap: hold = modifier, tap = letter.  No key-position
        // restriction, so any other key forces the hold (no HRM tuning).
        game_hml: game_hold_mod_left {
            compatible = "zmk,behavior-hold-tap";
            label = "GAME_HOLD_MOD_LEFT";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        // Game A: while Shift is held (running), A emits a plain Ctrl the
        // instant it is pressed (slide/crouch).  Otherwise it is the
        // hold-tap above, so 'a' still types.
        game_a: game_a {
            compatible = "zmk,behavior-mod-morph";
            label = "GAME_A";
            #binding-cells = <0>;
            bindings = <&game_hml LCTRL A>, <&kp LCTRL>;
            mods = <(MOD_LSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        to-base-layer {
            bindings = <&to 0>;
            key-positions = <34 35>;
            require-prior-idle-ms = <100>;
        };

        combo-dash {
            bindings = <&kp MINUS>;
            key-positions = <13 24>;
            layers = <0 1 2 3 4 5 6>;
        };

        combo-equal {
            bindings = <&kp EQUAL>;
            key-positions = <16 27>;
            layers = <0 1 2 3 4 5 6>;
        };

        combo-underscore {
            bindings = <&kp UNDER>;
            key-positions = <14 25>;
            layers = <0 1 2 3 4 5 6>;
        };

        combo-plus {
            bindings = <&kp PLUS>;
            key-positions = <15 26>;
            layers = <0 1 2 3 4 5 6>;
        };

        combo-bang {
            bindings = <&kp EXCL>;
            key-positions = <1 11>;
            layers = <0 1 2 3 4 5 6>;
        };

        combo-at {
            bindings = <&kp AT>;
            key-positions = <2 12>;
            layers = <0 1 2 3 4 5 6>;
        };

        combo-hash {
            bindings = <&kp HASH>;
            key-positions = <3 13>;
            layers = <0 1 2 3 4 5 6>;
        };

        combo-dollar {
            bindings = <&kp DOLLAR>;
            key-positions = <4 14>;
            layers = <0 1 2 3 4 5 6>;
        };

        combo-percent {
            bindings = <&kp PERCENT>;
            key-positions = <5 15>;
            layers = <0 1 2 3 4 5 6>;
        };

        combo-hat {
            bindings = <&kp CARET>;
            key-positions = <6 16>;
            layers = <0 1 2 3 4 5 6>;
        };

        combo-ampersand {
            bindings = <&kp AMPERSAND>;
            key-positions = <7 17>;
            layers = <0 1 2 3 4 5 6>;
        };

        combo-star {
            bindings = <&kp STAR>;
            key-positions = <8 18>;
            layers = <0 1 2 3 4 5 6>;
        };

        swap-meta-ctrl {
            bindings = <&tog 1>;
            key-positions = <12 10 17 19>;
            layers = <0 1 2 3 4 5 6>;
        };

        AOE-Hometown {
            bindings = <&kp H>;
            key-positions = <12 13>;
            layers = <5>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
              &kp Q                &kp W            &kp E             &kp R              &kp T        &kp Y    &kp U               &kp I                      &kp O             &kp P
              &hml LEFT_CONTROL A  &hml LEFT_ALT S  &hml LEFT_META D  &hml LEFT_SHIFT F  &kp G        &kp H    &hmr RIGHT_SHIFT J  &hmr RIGHT_META K          &hmr RIGHT_ALT L  &hmr RIGHT_CONTROL SEMICOLON
&lt 4 ESCAPE  &kp Z                &kp X            &kp C             &kp V              &kp B        &kp N    &kp M               &kp COMMA                  &kp DOT           &kp SLASH                     &kp APOSTROPHE
                                                    &mt LCTRL DEL     &lt 3 TAB          &kp SPACE    &kp RET  &lt 2 BSPC          &magic_shift LEFT_SHIFT 0
            >;
        };

        META-CTRL-SWAP {
            bindings = <
        &trans            &trans  &trans        &trans  &trans    &trans  &trans  &trans        &trans  &trans
        &hml LEFT_META A  &trans  &hml LCTRL D  &trans  &trans    &trans  &trans  &hmr RCTRL K  &trans  &hmr RIGHT_META SEMICOLON
&trans  &trans            &trans  &trans        &trans  &trans    &trans  &trans  &trans        &trans  &trans                     &trans
                                  &trans        &trans  &trans    &trans  &trans  &trans
            >;
        };

        Nav {
            display-name = "Nav";
            bindings = <
        &trans  &kp NUMBER_1  &kp NUMBER_2   &kp NUMBER_3  &kp PLUS        &kp EQUAL       &kp HOME        &kp DELETE    &kp END          &kp PAGE_UP
        &trans  &kp NUMBER_4  &kp NUMBER_5   &kp NUMBER_6  &kp MINUS       &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &trans
&trans  &trans  &kp NUMBER_7  &kp NUMBER_8   &kp NUMBER_9  &kp NUMBER_0    &kp NUMBER_0    &none           &trans        &trans           &kp PAGE_DOWN  &trans
                              &kp BACKSPACE  &trans        &trans          &trans          &trans          &trans
            >;
        };

        Sym {
            display-name = "Sym";
            bindings = <
        &kp GRAVE  &kp NUMBER_1  &kp NUMBER_2      &kp NUMBER_3          &kp NUMBER_4      &kp NUMBER_5     &kp NUMBER_6           &kp NUMBER_7       &kp NUMBER_8      &kp NUMBER_9
        &trans     &kp TILDE     &kp LEFT_BRACKET  &kp LEFT_PARENTHESIS  &kp LEFT_BRACE    &kp RIGHT_BRACE  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp QUESTION      &kp COLON
&trans  &trans     &kp PIPE      &trans            &trans                &kp N0            &kp NUMBER_0     &kp EQUAL              &kp LESS_THAN      &kp GREATER_THAN  &kp BACKSLASH  &kp DOUBLE_QUOTES
                                 &trans            &trans                &studio_unlock    &kp SPACE        &trans                 &trans
            >;
        };

        Fun {
            display-name = "Fun";
            bindings = <
        &to 7   &kp F1  &kp F2  &kp F3  &kp F10    &trans  &trans  &trans  &trans  &trans
        &to 5   &kp F4  &kp F5  &kp F6  &kp F11    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp F7  &kp F8  &kp F9  &kp F12    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans     &trans  &trans  &trans
            >;
        };

        AOE-Base {
            bindings = <
        &trans  &trans  &trans  &trans     &trans    &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans     &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans     &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &lt 6 TAB  &trans    &trans  &trans  &trans
            >;

            label = "AOE-Base";
        };

        AOE-Control {
            bindings = <
                &kp LS(LCTRL)  &kp NUMBER_1  &kp N2  &kp N3  &kp APOS     &trans  &trans  &trans  &trans  &trans
                &kp LCTRL      &kp N4        &kp N5  &kp N6  &kp DOT      &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp LA(LCTRL)  &kp N7        &kp N8  &kp N9  &kp COMMA    &trans  &trans  &trans  &trans  &trans  &trans
                                             &trans  &trans  &trans       &trans  &trans  &trans
            >;

            label = "AOE-Control";
        };

        // ------------------------------------------------------------------
        // Game: toggleable FPS/MMO layer.  Letters sit at their normal
        // QWERTY positions (rebind the *game* to ESDF); all hold-taps and
        // combos are stripped so nothing misfires under pressure.
        //
        //   * A      = &game_a : hold Ctrl / tap 'a', but a plain instant
        //              Ctrl while Shift is held (run + slide).
        //   * outer  = LSHIFT (sprint/walk)
        //   * LTh1   = ESC,  LTh2 = hold for Hotbar,  LTh3 = SPACE
        //   * exit   = &to 0 thumb-pair combo (34 + 35)
        // ------------------------------------------------------------------
        Game {
            display-name = "Game";
            bindings = <
               &kp Q        &kp W    &kp E    &kp R    &kp T        &kp Y    &kp U    &kp I        &kp O        &kp P
             &game_a        &kp S    &kp D    &kp F    &kp G        &kp H    &kp J    &kp K        &kp L        &kp SEMICOLON
&kp LSHIFT  &kp Z  &kp X    &kp C    &kp V    &kp B        &kp N    &kp M    &kp COMMA    &kp DOT      &kp SLASH  &kp APOSTROPHE
                                &kp ESCAPE  &mo 8  &kp SPACE    &kp RET  &kp BSPC  &kp DELETE
            >;
        };

        // ------------------------------------------------------------------
        // Hotbar: held via Game LTh2 (&mo 8).  MMO action bar.
        //   * pinky column = real mods   (Q spare, A=Ctrl, Z=Alt, outer=Shift)
        //   * centre 3x3   = 1-9, pressed by middle/index so the pinky can
        //                    hold a mod and chord
        //   * 0            = B (right of the pad)
        //   * right half / thumbs unchanged (transparent -> Game)
        // ------------------------------------------------------------------
        Hotbar {
            display-name = "Hotbar";
            bindings = <
                  &trans  &kp N1   &kp N2  &kp N3  &trans       &trans  &trans  &trans  &trans  &trans
               &kp LCTRL  &kp N4   &kp N5  &kp N6  &trans       &trans  &trans  &trans  &trans  &trans
&kp LSHIFT  &kp LALT  &kp N7  &kp N8  &kp N9  &kp N0       &trans  &trans  &trans  &trans  &trans  &trans
                                         &kp ESCAPE  &trans  &kp SPACE    &trans  &trans  &trans
            >;
        };
    };
};
