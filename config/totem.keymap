#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

// #define Base        0
// #define Nav         1
// #define Sym         2
// #define Fun         3
// #define Game        4
// #define Gameplus    5

&mt {
    quick-tap-ms = <100>;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <200>;
};

/ {
    behaviors {
        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <4 14 25 33 34 32 0 1 2 3 10 11 12 13 22 23 24 21 20>;
            hold-trigger-on-release;
            label = "HOMEROW_MODS_RIGHT";
        };

        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 26 27 28 29 30 31 36 37 35>;
            hold-trigger-on-release;
            label = "HOMEROW_MODS_LEFT";
        };

        magic_shift_tap: magic_shift_tap {
            compatible = "zmk,behavior-mod-morph";
            label = "MAGIC_SHIFT_TAP";
            bindings = <&sk LEFT_SHIFT>, <&caps_word>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        magic_shift: magic_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "MAGIC_SHIFT";
            bindings = <&kp>, <&magic_shift_tap>;

            #binding-cells = <2>;
            tapping-term-ms = <100>;
            flavor = "tap-preferred";
        };
    };

    combos {
        compatible = "zmk,combos";

        to-base-layer {
            bindings = <&to 0>;
            key-positions = <34 35>;
            require-prior-idle-ms = <100>;
            layers = <4 5>;
        };

        aoe4-city-center {
            bindings = <&kp H>;
            key-positions = <13 12>;
            layers = <5>;
        };

        combo-dash {
            bindings = <&kp MINUS>;
            key-positions = <14 25>;
        };

        combo-equal {
            bindings = <&kp EQUAL>;
            key-positions = <16 27>;
        };

        combo-underscore {
            bindings = <&kp UNDER>;
            key-positions = <13 24>;
        };

        combo-plus {
            bindings = <&kp PLUS>;
            key-positions = <15 26>;
        };

        combo-bang {
            bindings = <&kp EXCL>;
            key-positions = <1 11>;
        };

        combo-at {
            bindings = <&kp AT>;
            key-positions = <2 12>;
        };

        combo-hash {
            bindings = <&kp HASH>;
            key-positions = <3 13>;
        };

        combo-dollar {
            bindings = <&kp DOLLAR>;
            key-positions = <4 14>;
        };

        combo-percent {
            bindings = <&kp PERCENT>;
            key-positions = <5 15>;
        };

        combo-hat {
            bindings = <&kp CARET>;
            key-positions = <6 16>;
        };

        combo-ampersand {
            bindings = <&kp AMPERSAND>;
            key-positions = <7 17>;
        };

        combo-star {
            bindings = <&kp STAR>;
            key-positions = <8 18>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
              &kp Q                &kp W              &kp E            &kp R            &kp T        &kp Y    &kp U             &kp I                      &kp O               &kp P
              &hml LEFT_CONTROL A  &hml LEFT_SHIFT S  &hml LEFT_ALT D  &hml LEFT_GUI F  &kp G        &kp H    &hmr RIGHT_GUI J  &hmr RIGHT_ALT K           &hmr RIGHT_SHIFT L  &hmr RIGHT_CONTROL SEMICOLON
&lt 3 ESCAPE  &kp Z                &kp X              &kp C            &kp V            &kp B        &kp N    &kp M             &kp COMMA                  &kp DOT             &kp SLASH                     &kp APOSTROPHE
                                                      &mt LCTRL DEL    &lt 2 TAB        &kp SPACE    &kp RET  &lt 1 BSPC        &magic_shift LEFT_SHIFT 0
            >;
        };

        Nav {
            display-name = "Nav";
            bindings = <
        &kp GRAVE  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PLUS        &kp EQUAL  &kp HOME     &kp DELETE  &kp END        &trans
        &trans     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp MINUS       &kp SLASH  &kp LEFT     &kp UP      &kp RIGHT      &trans
&trans  &trans     &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0    &kp STAR   &kp PAGE_UP  &kp DOWN    &kp PAGE_DOWN  &trans  &trans
                                 &trans        &trans        &trans          &trans     &trans       &trans
            >;
        };

        Sym {
            display-name = "Sym";
            bindings = <
        &kp GRAVE  &kp NUMBER_1  &kp NUMBER_2      &kp NUMBER_3          &kp NUMBER_4      &kp NUMBER_5     &kp NUMBER_6           &kp NUMBER_7       &kp NUMBER_8  &kp NUMBER_9
        &trans     &trans        &kp LEFT_BRACKET  &kp LEFT_PARENTHESIS  &kp LEFT_BRACE    &kp RIGHT_BRACE  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &trans        &trans
&trans  &trans     &trans        &trans            &trans                &kp N0            &kp NUMBER_0     &kp EQUAL              &trans             &trans        &kp BACKSLASH  &kp APOS
                                 &trans            &trans                &studio_unlock    &kp SPACE        &trans                 &trans
            >;
        };

        Fun {
            display-name = "Fun";
            bindings = <
        &trans  &trans  &trans  &trans  &to 4     &trans  &trans  &trans  &trans  &kp F1
        &trans  &trans  &trans  &trans  &tog 5    &trans  &trans  &trans  &trans  &kp F10
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &kp F20  &kp F7
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        WASD-Gaming {
            display-name = "WASD-Game";
            bindings = <
            &kp TAB         &kp Q  &kp X      &kp E         &kp R     &trans  &trans  &trans  &trans  &trans
            &kp LEFT_SHIFT  &kp A  &kp W      &kp D         &kp F     &trans  &trans  &trans  &trans  &trans
&kp ESCAPE  &kp Z           &kp C  &kp S      &kp V         &kp T     &trans  &trans  &trans  &trans  &trans  &trans
                                   &kp LCTRL  &kp LEFT_ALT  &trans    &trans  &trans  &trans
            >;
        };

        AOE4-Gaming {
            display-name = "AOE4";
            bindings = <
           &trans  &trans  &trans     &trans     &trans         &trans  &trans  &trans  &trans  &trans
           &kp N4  &kp N3  &kp N2     &kp N1     &trans         &trans  &trans  &trans  &trans  &trans
&kp LSHFT  &kp N0  &kp N6  &kp N7     &kp N8     &kp N9         &trans  &trans  &trans  &trans  &trans  &trans
                           &kp LSHFT  &kp LCTRL  &lt 0 SPACE    &trans  &trans  &trans
            >;
        };
    };
};
